#include "imports/stdlib.fc";
#include "imports/misc.fc";

int read_id() {
    cell data = get_data();
    slice cdata = data.begin_parse();

    int id = cdata~load_int(32);
    return id;
}

() custom_msg(int value, int mode, int op_code, slice destination, slice payload) impure inline {
    cell msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(destination)
        .store_coins(value)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1) ;; shortcut
        .store_uint(1,  1) ;; inplace message body flag (Either 0 = inline or 1 = ref.cell)
        .store_ref(begin_cell()
                .store_uint(op_code, 32)
                .store_slice(payload)
                .end_cell()) ;; could-be-anything payload
        .end_cell();

    send_raw_message(msg, mode);
}

() send_message_comment(int value, int mode, slice comment, slice destination) impure inline {
    cell msg = begin_cell()
        .store_uint(0x18, 6) ;; 6 bit
        .store_slice(destination) ;; 267 bit
        .store_coins(value) ;; up to 120 bit
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1) ;; 107 bit
        .store_uint(0, 32) ;; 32 bit
        .store_slice(comment) ;; 1023 - (6 + 267 + 120 + 107 + 32) ~490 bit
        .end_cell();

    send_raw_message(msg, mode);
}

;; recv_internal is the main function of the contract and is called when it receives a message from other contracts
() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { ;; ignore all empty messages
        return ();
    }

    if (my_balance < ONE_TON / 12) { ;; https://docs.ton.org/v3/documentation/smart-contracts/func/docs/stdlib/#get_balance
        throw(401); ;; not enough balance
    }

    slice cs = in_msg_full.begin_parse(); ;; cs - CellSlice
    int flags = cs~load_uint(4);
    if (flags & 1) { ;; ignore all bounced messages 
        return ();
    }

    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32); ;; by convention, the first 32 bits of incoming message is the op

    if (op == op::set_first) {
        cell init_code = in_msg_body~load_ref();
        int root_id = read_id();


        ;; build and send 12 modes fireworks

        cell msg1 = build_firework(root_id + 1, ONE_TON, op::launch_first, init_code, sender_address);
        send_raw_message(msg1, 0);

        cell msg2 = build_firework(root_id + 2, ONE_TON / 4, 0x00000040, init_code, sender_address);
        send_raw_message(msg2, 0);
        
        cell msg3 = build_firework(root_id + 3, ONE_TON / 4, 0x00000041, init_code, sender_address);
        ;;cell msg3 = build_firework(root_id + 3, ONE_TON / 4, 0x00000041, init_code, sender_address);
        ;;slice fw3 = msg3.begin_parse().skip_bits(6)~load_msg_addr();
        ;;custom_msg(1300000, 1, 0, fw3, 0x00); ADD SOME COINS BEFOREHAND FOR TX TO BE SUCCESSFULL 
        send_raw_message(msg3, 0);

        cell msg4 = build_firework(root_id + 4, ONE_TON / 4, 0x00000050, init_code, sender_address);
        send_raw_message(msg4, 0);

        cell msg5 = build_firework(root_id + 5, ONE_TON / 4, 0x00000051, init_code, sender_address);
        send_raw_message(msg5, 0);

        cell msg6 = build_firework(root_id + 6, ONE_TON / 4, 0x00000080, init_code, sender_address);
        send_raw_message(msg6, 0);

        cell msg7 = build_firework(root_id + 7, ONE_TON / 4, 0x00000090, init_code, sender_address);
        send_raw_message(msg7, 0);
    }

    elseif (op == op::launch_first) {
        slice dest_address = in_msg_body~load_msg_addr();

        ;; prepare 6 messages https://docs.ton.org/v3/documentation/smart-contracts/message-management/message-modes-cookbook

        ;; msg1 - sending 0.1 TON with mode = 0, regular msg
        send_message_comment(ONE_TON / 10, 0, comment_msg_0, dest_address);

        ;; msg4 - sending 1 nanoTON with mode = 1, pay fee separately from msg value
        send_message_comment(ONE_TON / 10, 1, comment_msg_1, dest_address);

        ;; msg2 - sending 0.1 TON with mode = 2, ignore action errors
        send_message_comment(ONE_TON / 10, 2, comment_msg_2, dest_address);

        ;; msg3 - sending 0.1 TON with mode = 16, bounce on error
        send_message_comment(ONE_TON / 10, 16, comment_msg_16, dest_address);

        ;; msg5 - sending 1 nanoTON with mode = 17
        send_message_comment(ONE_TON / 10, 16 + 1, comment_msg_17, dest_address);
        
        ;; msg6 - sending 0.1 TON with mode = 64
        ;; send_message_comment(ONE_TON / 10, 64, comment_msg_64, dest_address);

        ;; msg7 - sending 0.1 TON with mode = 65
        ;; send_message_comment(ONE_TON / 10, 64 + 1, comment_msg_65, dest_address);

        ;; msg8 - sending 0.1 TON with mode = 80
        ;; send_message_comment(ONE_TON / 10, 64 + 16, comment_msg_80, dest_address);

        ;; msg9 - sending 0.1 TON with mode = 81
        ;; send_message_comment(ONE_TON / 10, 64 + 16 + 1, comment_msg_81, dest_address);

        ;; msg10 - sending 0.1 TON with mode = 128
        ;; send_message_comment(ONE_TON / 10, 128, comment_msg_128, dest_address);

        ;; msg11 - sending 0.1 TON with mode = 144
        ;; send_message_comment(ONE_TON / 10, 128 + 16, comment_msg_144, dest_address);

        ;; msgX - sending remaining TON with mode = 160
        ;; 32 is the flag for destroying the contract
        send_message_comment(0, 128 + 32, comment_msg_160, dest_address);
    }

    elseif (op == 0x00000040) { ;; 64 in hex
        slice dest_address = in_msg_body~load_msg_addr();
        ;; prepare a message
        ;; msg6 - sending remaining TON with mode = 64
        send_message_comment(0, 64, comment_msg_64, dest_address); 
        ;; you can send more than 0 TON, but in case of op::set_first the only in_msg of the contract is the one came with init and whole balance
        ;; therefore you will get exit code 37 in the action phase because it will try to send more than you have at the moment
        ;; you can mimic mode 64 with raw_reserve(coins, rsrv_mode) + mode 128

    }

    elseif (op == 0x00000041) { ;; 65 in hex
        slice dest_address = in_msg_body~load_msg_addr();
        ;; prepare a message
        ;; msg7 - sending remaining TON with mode = 65
        send_message_comment(0, 64 + 1, comment_msg_65, dest_address);

    }

    elseif (op == 0x00000050) { ;; 80 in hex
        slice dest_address = in_msg_body~load_msg_addr();
        ;; prepare a message        
        ;; msg8 - sending remaining TON with mode = 80
        send_message_comment(0, 64 + 16, comment_msg_80, dest_address);

    }

    elseif (op == 0x00000051) { ;; 81 in hex
        slice dest_address = in_msg_body~load_msg_addr();
        ;; prepare a message
        ;; msg9 - sending remaining TON with mode = 81
        send_message_comment(0, 64 + 16 + 1, comment_msg_81, dest_address);

    }

    elseif (op == 0x00000080) { ;; 128 in hex
        slice dest_address = in_msg_body~load_msg_addr();
        ;; prepare a message
        ;; msg10 - sending remaining balance with mode = 128
        send_message_comment(0, 128, comment_msg_128, dest_address);

    }

    elseif (op == 0x00000090) { ;; 144 in hex
        slice dest_address = in_msg_body~load_msg_addr();
        ;; prepare a message
        ;; msg10 - sending remaining balance with mode = 144
        send_message_comment(0, 128 + 16, comment_msg_144, dest_address);

    }

    elseif (op == op::faked_launch) {
        if (in_msg_body.preload_uint(8) == 1) {
            return_alt();
        }
        fake_launch(in_msg_body);
    }

    elseif (op == op::cutom_msg) { ;; custom_msg
        int mode = in_msg_body~load_uint(8);
        slice dest_address = in_msg_body~load_msg_addr();
        int sendop = in_msg_body~load_uint(32);

        custom_msg(ONE_TON / 10, mode, sendop, dest_address, sender_address);

    }

    else {
        throw(0xffff); ;; if the message contains an op that is not known to this contract, we throw
    }

    return();
}

int get_id() method_id {
    int id = read_id();
    return id;
}